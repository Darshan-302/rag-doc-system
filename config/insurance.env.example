# SAMPLE .env section for an insurance RAG deployment.
# Copy the relevant lines into your .env alongside the base settings from README.md.
# All values below are placeholders/defaults for local development — replace them
# for any real deployment. See docs/INSURANCE_RAG_GUIDE.md for full setup guidance.

# --- Insurance domain configuration ---
INSURANCE_CONFIG_MODELS_PATH=config/insurance_models.yaml
INSURANCE_CONFIG_PROMPTS_PATH=config/insurance_prompts.yaml
INSURANCE_SAMPLE_DATA_DIR=data/insurance

# Model selection for insurance workloads (see config/insurance_models.yaml)
INSURANCE_LLM_MODEL=qwen:7b
INSURANCE_EMBEDDING_MODEL=bge-large-en-v1.5

# Retrieval tuning for policy/claims documents
INSURANCE_CHUNK_SIZE=512
INSURANCE_CHUNK_OVERLAP=64
INSURANCE_TOP_K_DOCUMENTS=6

# --- Compliance / privacy toggles ---
# When true, health-insurance (PHI-bearing) document types are routed through the
# additional access-logging hook described in docs/INSURANCE_RAG_GUIDE.md.
INSURANCE_HIPAA_MODE_ENABLED=true

# Enables the lightweight audit-log hook (src/security/insurance_audit_log.py) that
# records document-access events for compliance review. Disabled by default outside
# this sample so local dev doesn't need extra setup.
INSURANCE_AUDIT_LOGGING_ENABLED=false

# Where audit log entries are written when INSURANCE_AUDIT_LOGGING_ENABLED=true.
INSURANCE_AUDIT_LOG_PATH=logs/insurance_audit.log

# Data retention window (days) used only for documentation/reference by the
# retention-policy notes in docs/INSURANCE_RAG_GUIDE.md — not enforced automatically.
INSURANCE_DATA_RETENTION_DAYS=2555
