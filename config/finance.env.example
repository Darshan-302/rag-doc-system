# Sample environment configuration for a Finance RAG deployment.
#
# SAMPLE FILE — fictional/demo values for testing and documentation purposes
# only. Copy relevant lines into your own .env (see .env.example at the repo
# root, if present, for the full base variable list from src/config.py) and
# replace every placeholder before any real deployment. Never commit a real
# .env file with production secrets.

# --- Base RAG settings (see src/config.py for the full list / defaults) ---
API_TITLE="Finance RAG Pipeline API"
LOG_LEVEL=INFO
DEBUG=false

# --- Finance model profile (see config/finance_models.yaml) ---
LLM_MODEL=qwen_32b_finance
EMBEDDING_MODEL=bge_large_finance
LLM_TEMPERATURE=0.2
CHUNK_SIZE=384
CHUNK_OVERLAP=80
TOP_K_DOCUMENTS=8

# --- Finance-specific prompt/regulation config paths ---
FINANCE_PROMPTS_CONFIG_PATH=config/finance_prompts.yaml
FINANCE_MODELS_CONFIG_PATH=config/finance_models.yaml
REGULATIONS_CONFIG_PATH=config/regulations.yaml

# --- Compliance / audit logging (design flags, see docs/FINANCE_RAG_GUIDE.md) ---
# Enable a lightweight audit-log hook that records who queried what and when,
# without storing full document contents (see src/compliance/audit_log.py).
FINANCE_AUDIT_LOGGING_ENABLED=true
FINANCE_AUDIT_LOG_PATH=logs/finance_audit.log
# Retention period for audit logs, in days (placeholder default; a real
# deployment must set this per applicable regulatory retention requirements,
# e.g., SEC Rule 17a-4 style record-retention obligations).
FINANCE_AUDIT_LOG_RETENTION_DAYS=2555

# --- Role-based access control (design flags; see docs/FINANCE_RAG_GUIDE.md) ---
FINANCE_RBAC_ENABLED=true
# Comma-separated roles recognized by the finance profile (illustrative only).
FINANCE_RBAC_ROLES=analyst,compliance_officer,auditor,admin

# --- Data encryption (design flags; see docs/FINANCE_RAG_GUIDE.md) ---
# These flags document intent; actual encryption-at-rest/in-transit must be
# implemented at the infrastructure layer (e.g., encrypted Postgres/MinIO
# volumes, TLS termination) — not solely by application-level flags.
FINANCE_ENCRYPTION_AT_REST_REQUIRED=true
FINANCE_ENCRYPTION_IN_TRANSIT_REQUIRED=true
FINANCE_PII_MASKING_ENABLED=true

# --- Placeholder secrets (REPLACE BEFORE ANY REAL USE — these are fake) ---
FINANCE_DB_PASSWORD=CHANGE_ME_fake_placeholder_password
FINANCE_API_SIGNING_SECRET=CHANGE_ME_fake_placeholder_secret
