# Sample environment variables for a HEALTHCARE deployment of the RAG system.
#
# This is an ILLUSTRATIVE, non-production example. Values here are NOT
# secrets -- replace every placeholder before use, source real secrets from a
# proper secrets manager (not a checked-in .env file) in production, and see
# docs/HEALTHCARE_RAG_GUIDE.md before processing any real patient data.
#
# Merge the variables below into your own .env alongside the base variables
# documented in README.md ("Configuration" section).

# --- Healthcare mode toggles -------------------------------------------------

# Enables healthcare-specific prompt/response behavior described in
# config/healthcare_prompts.yaml (medical disclaimer injection, emergency
# escalation keyword check, source-citation requirement).
HEALTHCARE_MODE_ENABLED=true

# Path to the healthcare-specific config files (relative to repo root).
HEALTHCARE_MODELS_CONFIG=config/healthcare_models.yaml
HEALTHCARE_PROMPTS_CONFIG=config/healthcare_prompts.yaml
DRUG_DATABASE_CONFIG=config/drug_database.yaml

# --- PHI / compliance-related settings --------------------------------------

# When true, the (illustrative) audit logging hook in
# src/security/healthcare_audit_log.py writes an audit entry for
# PHI-adjacent actions. See docs/HEALTHCARE_RAG_GUIDE.md section 7.
HIPAA_AUDIT_LOGGING_ENABLED=true

# Local path used by the illustrative audit log hook. In production this
# should instead point at a centralized, access-controlled, tamper-evident
# log store (e.g. a SIEM) -- not a local file.
HIPAA_AUDIT_LOG_PATH=./logs/healthcare_audit.log

# Toggle for a PHI de-identification step an implementer would wire in ahead
# of chunking/embedding (see docs/HEALTHCARE_RAG_GUIDE.md section 4.3). No
# de-identification model ships in this repository; this flag documents the
# intended integration point only.
PHI_DEIDENTIFICATION_ENABLED=false

# Minimum retention period (days) for audit logs, illustrative default only
# -- confirm the real requirement with legal/compliance.
HIPAA_AUDIT_LOG_RETENTION_DAYS=2190

# --- Encryption -------------------------------------------------------------

# Whether object storage (MinIO/S3) and database volumes should be treated
# as containing ePHI and therefore require encryption-at-rest. This flag is
# documentation-only in this repo; actual encryption is configured at the
# infrastructure layer (e.g., MinIO/S3 server-side encryption, encrypted
# PostgreSQL volumes/KMS).
EPHI_ENCRYPTION_AT_REST_REQUIRED=true

# --- Model selection (healthcare-tuned defaults; see config/healthcare_models.yaml) ---

LLM_MODEL=qwen_32b
LLM_TEMPERATURE=0.2
TOP_K_DOCUMENTS=4
