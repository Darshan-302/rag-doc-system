# =============================================================================
# RAG System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values for your deployment:
#   cp .env.example .env
#
# Every variable below maps 1:1 to a field on Settings in src/config.py.
# See README.md "Supported LLM Models" / "Model Selection Guide" and
# docs/ARCHITECTURE.md "Model Selection & Fallback Strategy" for background
# on the model-flexibility variables (LLM_MODEL through LLM_TIMEOUT below).
# =============================================================================

# --- API ---
API_TITLE=RAG Pipeline API
API_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
DB_USER=rag_user
DB_PASSWORD=rag_password
DB_NAME=rag_db

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# --- Vector Database (Weaviate) ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=weaviate-key

# =============================================================================
# LLM / Model Runtime Flexibility (Ollama)
# =============================================================================

# Base URL of the Ollama server used for both LLM inference and embeddings.
OLLAMA_BASE_URL=http://localhost:11434

# The LLM to load. Either a config/models.yaml key (mistral, qwen, qwen_32b,
# llama2) or its ollama tag (mistral:7b, qwen:7b, qwen:32b, llama2:7b).
# Runtime-changeable: set this env var to switch models without code changes.
LLM_MODEL=qwen:7b

# Embedding model pulled/served via Ollama.
EMBEDDING_MODEL=nomic-embed-text:latest

# --- Inference Parameters ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9
EMBEDDING_BATCH_SIZE=128

# --- Multi-Model Runtime Flexibility (see config/models.yaml, src/models/registry.py) ---

# When true, the RAG pipeline picks the best-fitting model from
# config/models.yaml instead of hard-failing when LLM_MODEL doesn't fit in
# RAM_AVAILABLE_GB.
ENABLE_MODEL_AUTO_SELECT=false

# Available system RAM/VRAM in GB, used to validate LLM_MODEL fits before it
# is loaded. Leave unset to auto-detect at startup (via psutil when
# installed; see scripts/validate_system.py to check this yourself).
RAM_AVAILABLE_GB=

# Coarse sizing hint consumed by ENABLE_MODEL_AUTO_SELECT and
# scripts/select_models.py --recommend. One of: small, medium, large.
PREFERRED_MODEL_SIZE=medium

# Ordered, comma-separated list of models to try if LLM_MODEL doesn't fit or
# fails to load (issue #1's "fallback chain": model1 -> model2 -> model3).
# The bracketed form "[qwen:32b, qwen:7b]" is also accepted.
MODEL_FALLBACK_CHAIN=qwen:7b,mistral:7b

# Quantization method requested when loading LLM_MODEL. One of: fp16, int8,
# int4. See README "Quantization Benefits": int8 ~50% VRAM reduction, int4
# ~75% VRAM reduction, at a small quality cost (see config/models.yaml
# `quantizations` block per model for exact figures).
QUANTIZATION_METHOD=fp16

# If the requested QUANTIZATION_METHOD still doesn't fit RAM_AVAILABLE_GB,
# allow the pipeline to automatically drop to a more aggressive quantization
# (fp16 -> int8 -> int4) before falling back to a smaller model.
ALLOW_QUANTIZATION_FALLBACK=true

# --- Performance Tuning ---
BATCH_SIZE=32
MAX_CONCURRENT_REQUESTS=4
CONTEXT_LENGTH=2048
LLM_TIMEOUT=30

# =============================================================================
# Document Processing & Retrieval
# =============================================================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_DOCUMENT_SIZE_MB=100

TOP_K_DOCUMENTS=5
SIMILARITY_THRESHOLD=0.3

# --- S3 / MinIO (document storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# --- Multi-Tenancy ---
ENABLE_MULTI_TENANCY=true

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# --- Celery (async document indexing) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# Example configurations by deployment size
# (uncomment ONE block below, or use it as a reference - do not paste all
# three, they set conflicting values for the same variables)
# =============================================================================

# --- Small / 16GB RAM (Development, MVP) ---
# LLM_MODEL=qwen:7b
# RAM_AVAILABLE_GB=16
# PREFERRED_MODEL_SIZE=small
# MODEL_FALLBACK_CHAIN=qwen:7b,mistral:7b
# QUANTIZATION_METHOD=fp16
# BATCH_SIZE=16
# MAX_CONCURRENT_REQUESTS=2

# --- Medium / 32GB RAM (Recommended, small production) ---
# LLM_MODEL=qwen:32b
# RAM_AVAILABLE_GB=32
# PREFERRED_MODEL_SIZE=medium
# MODEL_FALLBACK_CHAIN=qwen:32b,qwen:7b,mistral:7b
# QUANTIZATION_METHOD=int4
# ALLOW_QUANTIZATION_FALLBACK=true
# BATCH_SIZE=32
# MAX_CONCURRENT_REQUESTS=4

# --- Large / 48GB+ RAM (Enterprise, high quality) ---
# LLM_MODEL=qwen:32b
# RAM_AVAILABLE_GB=48
# PREFERRED_MODEL_SIZE=large
# MODEL_FALLBACK_CHAIN=qwen:32b,qwen:7b,mistral:7b
# QUANTIZATION_METHOD=fp16
# ALLOW_QUANTIZATION_FALLBACK=true
# BATCH_SIZE=64
# MAX_CONCURRENT_REQUESTS=8
# CONTEXT_LENGTH=4096
